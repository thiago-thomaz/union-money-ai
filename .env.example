# UNION MONEY AI - Configurações de Ambiente (Fase 4: Autonomia Total 24/7)
APP_NAME="UNION MONEY AI"
SITE_NAME="UNION OFERTAS"
APP_VERSION="4.0.0"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT=8000
PUBLIC_BASE_URL="http://127.0.0.1:8000"
SECRET_KEY="change-this-secret-key-in-production-union-money-ai"

# Banco de Dados (SQLite padrão inicial; altere para postgresql+psycopg://... quando necessário)
DATABASE_URL="sqlite:///./data/union_money_ai.db"

# Meta de Longo Prazo (Apenas referência de acompanhamento patrimonial, sem promessa garantida)
LONG_TERM_PATRIMONY_GOAL_BRL=1000000.00

# ==================================================
# AUTONOMIA APÓS ATIVAÇÃO (Seção 11)
# (Ativadas somente quando os recursos estiverem tecnicamente autorizados e operacionais)
# ==================================================
AUTONOMY_MODE=FULL
AUTO_PRODUCT_DISCOVERY=true
AUTO_PRODUCT_UPDATE=true
AUTO_AFFILIATE_LINKS=true
AUTO_CONTENT_GENERATION=true
AUTO_VIDEO_RENDERING=true
AUTO_SEO=true
AUTO_PUBLISHING=true
AUTO_ANALYTICS=true
AUTO_COMMISSION_SYNC=true
AUTO_FINANCIAL_REPORTS=true
AUTO_RECOVERY=true

# A. Mercado Livre (OAuth 2.0 + Programa de Afiliados)
ML_APP_ID=""
ML_CLIENT_SECRET=""
ML_ACCESS_TOKEN=""
ML_REFRESH_TOKEN=""
ML_AFFILIATE_TAG=""

# B. Amazon Brasil (Associados + PA-API 5.0 / Creators API)
AMAZON_PARTNER_TAG=""
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_CREATORS_TOKEN=""
AMAZON_HOST="webservices.amazon.com.br"
AMAZON_REGION="us-east-1"

# C. Shopee Brasil (Open Platform Affiliate GraphQL API)
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""
SHOPEE_AFFILIATE_ID=""

# D. YouTube / YouTube Shorts (YouTube Data API v3 + OAuth 2.0)
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_ACCESS_TOKEN=""
YOUTUBE_REFRESH_TOKEN=""

# E. Instagram Reels (Instagram Graph API)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# F. Pinterest (Pinterest API v5 + OAuth 2.0)
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_ACCESS_TOKEN=""
PINTEREST_REFRESH_TOKEN=""
PINTEREST_BOARD_ID=""

# G. Google Search Console (Search Console API + OAuth 2.0)
GSC_CLIENT_ID=""
GSC_CLIENT_SECRET=""
GSC_ACCESS_TOKEN=""
GSC_REFRESH_TOKEN=""
GSC_SITE_URL=""

# H. Google Analytics 4 (GA4 Data API + Measurement Protocol)
GA4_PROPERTY_ID=""
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
GA4_ACCESS_TOKEN=""

# Leitor Automático Opcional de Relatórios por E-mail (OAuth Somente Leitura)
REPORT_EMAIL_IMAP_HOST=""
REPORT_EMAIL_USER=""
REPORT_EMAIL_OAUTH_TOKEN=""

# Agendador Autônomo Interno (APScheduler - Sem n8n)
ENABLE_SCHEDULER=true
